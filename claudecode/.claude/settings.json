{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/stamp-start.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/stamp-duration.sh"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/collect-tokens.sh"
          }
        ]
      }
    ]
  }
}
